# Copy to .env.local and fill in real values.

# ---- Supabase Postgres (project: LD Silk Mills) --------------------------
# App runtime. Supavisor POOLER, transaction mode, port 6543.
# This is the only option that is both IPv4-reachable and safe on Vercel's
# serverless functions. Copy the exact string from
#   Supabase → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Schema DDL only (drizzle-kit generate/migrate/push, db:studio).
# DIRECT connection, port 5432 — the pooler cannot run migrations.
# NOTE: db.<ref>.supabase.co resolves IPv6-only; if your network is IPv4-only,
# use the SESSION pooler (same pooler host, port 5432) instead.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# All app tables live in this schema, never `public` — see db/schema.ts.
# Kept out of Supabase's exposed schemas so the Data API cannot reach orders.

# ---- App -----------------------------------------------------------------
# Static API key the Embroidery System sends as the `x-api-key` header
# to the read-only export route (/api/export/orders). Use a long random string.
EXPORT_API_KEY=replace-with-a-long-random-string

# Auth.js v5 secret — used to sign/encrypt session JWTs.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string

# Google OAuth (optional — blank hides the Google button on the login page).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# App version surfaced in the UI footer and /api/health.
NEXT_PUBLIC_APP_VERSION=1.0.0
